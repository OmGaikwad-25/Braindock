generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int                @id @default(autoincrement())
  name              String
  email             String             @unique
  password          String
  role              Role               @default(STUDENT)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  assessments       Assessment[]
  codingSubmissions CodingSubmission[]
  interviews        Interview[]
  reports           Report[]
  profile           StudentProfile?
  studyPlan         StudyPlan[]
  tests             Test[]
  userRoadmaps      UserRoadmap[]
  userTasks         UserTask[]

  @@index([email])
}

model StudentProfile {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  branch          String   @default("Computer Engineering")
  year            Int      @default(3)
  cgpa            Float    @default(0)
  skills          String[] @default([])
  targetCompanies String[] @default([])
  careerGoals     String   @default("")
  resumeUrl       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Assessment {
  id        Int      @id @default(autoincrement())
  userId    Int
  score     Float
  maxScore  Float    @default(100)
  aptitude  Float    @default(0)
  technical Float    @default(0)
  coding    Float    @default(0)
  answers   Json     @default("{}")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Task {
  id          Int        @id @default(autoincrement())
  title       String
  description String     @default("")
  type        TaskType
  difficulty  Difficulty @default(EASY)
  topic       String     @default("General")
  points      Int        @default(10)
  content     Json       @default("{}")
  createdAt   DateTime   @default(now())
  userTasks   UserTask[]
}

model UserTask {
  id             Int        @id @default(autoincrement())
  userId         Int
  taskId         Int
  status         TaskStatus @default(PENDING)
  assignedDate   DateTime   @default(now())
  completionDate DateTime?
  task           Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId, assignedDate])
  @@index([userId])
  @@index([assignedDate])
}

model Test {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String   @default("Weekly Test")
  score     Float    @default(0)
  maxScore  Float    @default(100)
  answers   Json     @default("[]")
  questions Json     @default("[]")
  duration  Int      @default(60)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Interview {
  id        Int           @id @default(autoincrement())
  userId    Int
  type      InterviewType @default(TECHNICAL)
  score     Float         @default(0)
  maxScore  Float         @default(100)
  feedback  String        @default("")
  messages  Json          @default("[]")
  duration  Int           @default(0)
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Opportunity {
  id          Int             @id @default(autoincrement())
  company     String
  role        String
  type        OpportunityType
  description String          @default("")
  location    String          @default("")
  deadline    DateTime?
  applyUrl    String?
  salary      String?
  skills      String[]        @default([])
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())

  @@index([type])
  @@index([isActive])
}

model Report {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String
  type        String   @default("weekly")
  data        Json     @default("{}")
  generatedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StudyPlan {
  id        Int      @id @default(autoincrement())
  userId    Int
  weekNum   Int      @default(1)
  plan      Json     @default("[]")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CodingProblem {
  id          Int                @id @default(autoincrement())
  title       String
  description String
  difficulty  Difficulty         @default(EASY)
  topic       String             @default("General")
  constraints String             @default("")
  starterCode Json               @default("{}")
  solution    Json               @default("{}")
  testCases   Json               @default("[]")
  examples    Json               @default("[]")
  tags        String[]           @default([])
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  submissions CodingSubmission[]

  @@index([difficulty])
  @@index([topic])
}

model CodingSubmission {
  id          Int           @id @default(autoincrement())
  userId      Int
  problemId   Int
  code        String
  language    String        @default("javascript")
  status      String        @default("PENDING")
  passedTests Int           @default(0)
  totalTests  Int           @default(0)
  output      Json          @default("[]")
  runtime     Int           @default(0)
  createdAt   DateTime      @default(now())
  problem     CodingProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([problemId])
}

model MCQQuestion {
  id          Int        @id @default(autoincrement())
  question    String
  options     String[]
  correct     Int        @default(0)
  topic       String     @default("General")
  difficulty  Difficulty @default(EASY)
  explanation String     @default("")
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  category    String     @default("General")

  @@index([category])
  @@index([topic])
  @@index([difficulty])
}

model Roadmap {
  id           Int           @id @default(autoincrement())
  title        String
  duration     Int
  price        Float         @default(0)
  description  String        @default("")
  features     String[]      @default([])
  plan         Json          @default("[]")
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  userRoadmaps UserRoadmap[]
}

model UserRoadmap {
  id          Int      @id @default(autoincrement())
  userId      Int
  roadmapId   Int
  purchasedAt DateTime @default(now())
  isActive    Boolean  @default(true)
  roadmap     Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roadmapId])
  @@index([userId])
}

enum Role {
  STUDENT
  ADMIN
  RECRUITER
}

enum TaskType {
  CODING
  MCQ
  LEARNING
  PRACTICE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum TaskStatus {
  PENDING
  COMPLETED
  SKIPPED
}

enum InterviewType {
  TECHNICAL
  HR
  SYSTEM_DESIGN
}

enum OpportunityType {
  INTERNSHIP
  PLACEMENT
  EVENT
}
